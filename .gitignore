# Allowlist: everything is ignored unless it is un-ignored below. The project folder also holds
# private material (flash backups with WiFi credentials, logs, the stock firmware and its
# disassembly), so nothing gets published by accident.
/*
!/.gitignore
!/README.md
!/繁中README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md

!/.github/
/.github/*
!/.github/FUNDING.yml

!/docs/
/docs/*
!/docs/使用說明.md
!/docs/安裝說明.md
!/docs/tip-forming.md
!/docs/tip-forming-generic.md
!/docs/en/
/docs/en/*
!/docs/en/user-guide.md
!/docs/en/installation.md
!/docs/en/tip-forming.md
!/docs/en/tip-forming-generic.md

!/firmware/
/firmware/*
!/firmware/pbf-custom/
/firmware/pbf-custom/*
!/firmware/pbf-custom/src/
!/firmware/pbf-custom/platformio.ini
!/firmware/pbf-custom/partitions_stock.csv
!/firmware/pbf-custom/strip_paths.py
!/firmware/pbf-custom/tests/
/firmware/pbf-custom/tests/__pycache__/
